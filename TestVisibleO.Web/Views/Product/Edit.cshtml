@model TestVisibleO.Application.DTOs.UpdateProductDto

<h2>Editar Producto</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label>Nombre</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="form-group">
        <label>Descripción</label>
        <input asp-for="Description" class="form-control" />
    </div>

    <div class="form-group">
        <label>Precio</label>
        <input asp-for="Price" class="form-control" />
    </div>

    <div class="form-group">
        <label>Precio con Descuento (opcional)</label>
        <input asp-for="DiscountPrice" class="form-control" />
    </div>

    <div class="form-group">
        <label>URL Imagen</label>
        <input asp-for="ImageUrl" class="form-control" />
    </div>

    <button class="btn btn-primary">Guardar Cambios</button>
</form>


@section Scripts {
    <script>
        document.querySelector("form").addEventListener("submit", function (e) {
            const price = parseFloat(document.querySelector("#Price").value);
            const discount = parseFloat(document.querySelector("#DiscountPrice").value);

            if (!isNaN(discount) && discount >= price) {
                alert("El precio con descuento debe ser menor que el precio original.");
                e.preventDefault();
            }
        });
    </script>
}
